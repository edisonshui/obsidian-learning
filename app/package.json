{
  "name": "flash",
  "productName": "Flash",
  "version": "0.1.0",
  "description": "A desktop companion for the learning vault: your tutor's terminal, the live log, and your progress in one window.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder",
    "postinstall": "node scripts/fix-pty.js",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "icon": "electron scripts/make-icon.js"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "katex": "^0.19.1",
    "mermaid": "^12.2.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "author": "Edison Hui",
  "build": {
    "appId": "com.edisonshui.flash",
    "productName": "Flash",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "renderer/**",
      "node_modules/**",
      "!node_modules/**/*.{md,map,ts}",
      "!node_modules/**/{test,tests,docs,example,examples}/**"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.education",
      "identity": null
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education",
      "maintainer": "Edison Hui"
    },
    "npmRebuild": false
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
